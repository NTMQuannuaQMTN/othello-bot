# Keep the Vercel deploy small and torch-free. Vercel's Root Directory is `web`,
# but the whole repo is still cloned here (this file runs at the repo root), so
# web/vercel-build can `cp ../src/othello_rl web/api/othello_rl`. Do NOT ignore
# /src. The torch checkpoints / training code / pyproject (which the uv Python
# builder would read and install torch from) are dropped.
/requirements.txt
/requirements-dev.txt
/pyproject.toml

# training / research / data — never needed at runtime
/checkpoints
/data
/results
/experiments
/scripts
/tests
/docs
/notebooks
/Egaroucid-console_v7.8.1
/Egaroucid-console*
*.pt
*.ipynb

web/node_modules
web/dist
node_modules
.git
