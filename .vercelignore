# Keep the Vercel deploy small and torch-free.
# The build (`npm run vercel-build`) copies src/othello_rl -> api/othello_rl and
# builds web/. The Python function bundles everything in api/.

# root requirements.txt pins torch (~1 GB) — the function uses api/requirements.txt
/requirements.txt
/requirements-dev.txt
/pyproject.toml

# training / research / data — never needed at runtime
/checkpoints
/data
/results
/experiments
/scripts
/tests
/docs
/notebooks
/Egaroucid-console_v7.8.1
/Egaroucid-console*
*.pt
*.ipynb

web/node_modules
web/dist
node_modules
.git
