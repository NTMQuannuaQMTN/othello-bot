__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.pt
*.pth
!models/*.pt
webapp_state/
.DS_Store

# Local copy of the Egaroucid for Console engine (used by scripts/play_egaroucid.py
# — auto-discovered here or under ~/Downloads; large, not ours, never committed).
/Egaroucid-console_v7.8.1/
/Egaroucid-console*/

# Historical-game pipeline working data (local; like checkpoints/experiments/).
# Manifests / stats reports are copied into experiments/ (committed) by the scripts.
data/raw/
data/processed/
data/rejected/

# web front end (Vite + React)
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*
runs/
.venv/
venv/

# Experiment outputs: keep small text/plot artifacts, drop logs & checkpoints.
experiments/**
!experiments/.gitkeep
!experiments/RESULTS.md
!experiments/index.jsonl
!experiments/**/
!experiments/**/report.md
!experiments/**/summary.md
!experiments/**/results.json
!experiments/**/metrics.jsonl
!experiments/**/resolved_config.yaml
!experiments/**/run_config.yaml
!experiments/**/metadata.json
!experiments/**/bot_eval.json
!experiments/**/bot_eval.md
!experiments/**/tracking.json
!experiments/**/tracking.md
!experiments/**/*.png
experiments/**/*.log
experiments/_*.log
# Checkpoint tree: commit the registry + the initial & production checkpoints;
# training / candidate outputs in experiments/ stay local.
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/registry.json
!checkpoints/initial/
!checkpoints/initial/*.pt
!checkpoints/production/
!checkpoints/production/*.pt
!checkpoints/experiments/
checkpoints/experiments/*
!checkpoints/experiments/.gitkeep

# tournament run logs (keep the JSON, drop the console log)
results/**/*.log

# vendored into the Vercel function by "npm run vendor-api" (build step)
/web/api/othello_rl/
